# Database — server-side only. Use Neon’s pooled/serverless connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require

# Authentication — server-side only. Generate a high-entropy value (at least 32 bytes).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public application URL, without a trailing slash. Required in deployed environments.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side only. Keep stable in production so server actions remain valid
# across concurrent Vercel function instances and rolling deployments.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-stable-32-byte-base64-value

# Cloudinary media storage and delivery. The API secret is server-side only;
# signed browser uploads receive a short-lived signature and the API key only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Transactional email — server-side only. The notification recipient is the
# email currently saved in Site Settings, not a value hardcoded in application code.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Star Energies <enquiries@your-verified-domain.example>
