# Database — server-side only. Use Neon’s pooled/serverless connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require

# Authentication — server-side only. Generate a high-entropy value (at least 32 bytes).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public application URL, without a trailing slash. Required in deployed environments.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# S3-compatible object storage — server-side only (Cloudflare R2 is a suitable default).
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=star-energies-media
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret
# Public bucket custom domain or CDN base URL, without a trailing slash.
S3_PUBLIC_BASE_URL=https://media.example.com

# One-off initial administrator bootstrap only. Never commit real values.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=Star Energies Administrator
